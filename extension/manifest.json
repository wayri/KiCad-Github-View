{
  "manifest_version": 3,
  "name": "KiCad Visual Review for GitHub and GitLab",
  "version": "0.12.84",
  "description": "Browser-only KiCad schematic and PCB review on GitHub, GitLab.com and configured GitLab servers, with issue comments.",
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "storage": {
    "managed_schema": "managed-policy-schema.json"
  },
  "content_scripts": [],
  "web_accessible_resources": [
    {
      "resources": [
        "project-launcher.html",
        "project-viewer.html",
        "browser-viewer.html",
        "gerber-viewer.html"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "KiCad Visual Review",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open a KiCad project in a standalone viewer"
    }
  },
  "permissions": [
    "storage",
    "offscreen",
    "identity",
    "scripting",
    "activeTab"
  ],
  "sandbox": {
    "pages": [
      "html-sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; frame-src about:; child-src about:; connect-src 'none'; img-src data:; object-src 'none'; form-action 'none'; base-uri 'none';"
  },
  "optional_permissions": [
    "downloads",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
