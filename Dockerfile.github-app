FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f AS builder
WORKDIR /app
COPY scripts/requirements-linux.lock ./scripts/requirements-linux.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r scripts/requirements-linux.lock
COPY pyproject.toml README.md LICENSE ./
COPY kicad_vizdiff ./kicad_vizdiff
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation .
COPY scripts/package_app_web.py ./scripts/package_app_web.py
COPY app_web ./app_web
COPY extension ./extension
RUN python scripts/package_app_web.py

FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f
WORKDIR /app
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /app/.vizdiff/app-web /app/.vizdiff/app-web
RUN groupadd --system --gid 10001 review && useradd --system --uid 10001 --gid 10001 review && mkdir -p /var/lib/kicad-review && chown review /var/lib/kicad-review
ENV VIZDIFF_STATE_DB=/var/lib/kicad-review/deliveries.sqlite3 PYTHONDONTWRITEBYTECODE=1
VOLUME ["/var/lib/kicad-review"]
USER 10001:10001
EXPOSE 8780
CMD ["python", "-m", "kicad_vizdiff.app_server", "--host", "0.0.0.0", "--port", "8780"]
