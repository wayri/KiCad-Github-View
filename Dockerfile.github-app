FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY kicad_vizdiff ./kicad_vizdiff
RUN pip install --no-cache-dir '.[github]'
COPY scripts/package_app_web.py ./scripts/package_app_web.py
COPY app_web ./app_web
COPY extension/worksheet.js extension/design-diff.js extension/owned-canvas.js extension/schematic-renderer.js extension/pcb-renderer.js ./extension/
COPY extension/vendor/spike-board3d.bundle.js extension/vendor/SPIKE-ENGINE-NOTICE.md extension/vendor/THREE-LICENSE ./extension/vendor/
RUN python scripts/package_app_web.py
RUN useradd --system --uid 10001 review && mkdir -p /var/lib/kicad-review && chown review /var/lib/kicad-review
ENV VIZDIFF_STATE_DB=/var/lib/kicad-review/deliveries.sqlite3
VOLUME ["/var/lib/kicad-review"]
USER review
EXPOSE 8780
CMD ["python", "-m", "kicad_vizdiff.app_server", "--host", "0.0.0.0", "--port", "8780"]
