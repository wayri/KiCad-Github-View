{
  "name": "kicad-visual-review",
  "displayName": "KiCad Visual Review",
  "description": "View KiCad schematics and PCBs, inspect nets and assembly fields, and resolve Git conflicts visually.",
  "version": "0.12.75",
  "publisher": "wayri",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "KiCad",
    "schematic",
    "PCB",
    "github.dev"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCustomEditor:kicadVisualReview.viewer",
    "onCommand:kicadVisualReview.open",
    "onCommand:kicadVisualReview.openPair",
    "onCommand:kicadVisualReview.resolveConflicts"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Drawing files are read only. Explicit review actions write the annotation sidecar; no project code or external commands are executed."
    }
  },
  "contributes": {
    "configuration": {
      "title": "KiCad Visual Review deployment",
      "properties": {
        "kicadVisualReview.networkAccess": {
          "type": "boolean", "default": true, "scope": "application", "ignoreSync": true,
          "description": "Allow provider network access and account authentication. User/application setting only; repository settings cannot enable it. Local viewing remains available."
        },
        "kicadVisualReview.providerWrites": {
          "type": "boolean", "default": true, "scope": "application", "ignoreSync": true,
          "description": "Allow provider publication, uploads and chat changes. Disable for remote read-only review; local notes remain available. Repository settings cannot enable it."
        }
      }
    },
    "commands": [
      {
        "command": "kicadVisualReview.open",
        "title": "KiCad: Open Visual Viewer"
      },
      {
        "command": "kicadVisualReview.openPair",
        "title": "KiCad: Open Paired Schematic and PCB Review"
      },
      {
        "command": "kicadVisualReview.openSidecar",
        "title": "KiCad: Open Review Sidecar"
      },
      {
        "command": "kicadVisualReview.importLegacyNotes",
        "title": "KiCad: Import Previous Workspace Notes into Sidecar"
      },
      {
        "command": "kicadVisualReview.refreshNavigator",
        "title": "KiCad: Refresh Review Navigator"
      },
      {
        "command": "kicadVisualReview.resolveConflicts",
        "title": "KiCad: Resolve Git Conflict Visually"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "kicadVisualReview.navigator",
          "name": "KiCad Review"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "kicadVisualReview.viewer",
        "displayName": "KiCad Visual Review",
        "selector": [
          {
            "filenamePattern": "*.kicad_sch"
          },
          {
            "filenamePattern": "*.kicad_pcb"
          },
          {
            "filenamePattern": "*.kicad_pro"
          },
          {
            "filenamePattern": "*.kicad_prl"
          },
          {
            "filenamePattern": "*.kicad_dru"
          },
          {
            "filenamePattern": "*.kicad_wks"
          },
          {
            "filenamePattern": "*.gbr"
          },
          {
            "filenamePattern": "*.ger"
          },
          {
            "filenamePattern": "*.gerber"
          },
          {
            "filenamePattern": "*.gtl"
          },
          {
            "filenamePattern": "*.gbl"
          },
          {
            "filenamePattern": "*.gts"
          },
          {
            "filenamePattern": "*.gbs"
          },
          {
            "filenamePattern": "*.gto"
          },
          {
            "filenamePattern": "*.gbo"
          },
          {
            "filenamePattern": "*.gtp"
          },
          {
            "filenamePattern": "*.gbp"
          },
          {
            "filenamePattern": "*.gko"
          },
          {
            "filenamePattern": "*.gm1"
          },
          {
            "filenamePattern": "*.drl"
          },
          {
            "filenamePattern": "*.xln"
          },
          {
            "filenamePattern": "fp-lib-table"
          },
          {
            "filenamePattern": "sym-lib-table"
          },
          {
            "filenamePattern": "*.gm[0-9]*"
          },
          {
            "filenamePattern": "*.g[0-9]*"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "kicadVisualReview.open",
          "when": "resourceExtname =~ /\\.(kicad_(sch|pcb|pro|prl|dru|wks)|gbr|ger|gerber|gtl|gbl|gts|gbs|gto|gbo|gtp|gbp|gko|gm[0-9]+|g[0-9]+|drl|xln)$/",
          "group": "navigation"
        },
        {
          "command": "kicadVisualReview.openPair",
          "when": "resourceExtname == .kicad_sch || resourceExtname == .kicad_pcb",
          "group": "navigation"
        },
        {
          "command": "kicadVisualReview.resolveConflicts",
          "when": "resourceExtname == .kicad_sch || resourceExtname == .kicad_pcb",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wayri/KiCad-Github-View.git"
  },
  "homepage": "https://github.com/wayri/KiCad-Github-View",
  "bugs": {
    "url": "https://github.com/wayri/KiCad-Github-View/issues"
  },
  "icon": "icon.png"
}
