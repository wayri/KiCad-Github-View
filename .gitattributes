* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary
*.zip binary
*.vsix binary
*.glb binary

# Generated GLSL strings contain intentional trailing whitespace
extension/vendor/spike-board3d.bundle.js -whitespace

# Preserve upstream STEP dependency bytes and recorded provenance hashes
extension/vendor/occt/* -text whitespace=cr-at-eol

# Preserve bytes in the generated worker containing the pinned STEP importer
extension/step-worker-vscode.js -text whitespace=cr-at-eol
