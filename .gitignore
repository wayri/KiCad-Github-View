__pycache__/
*.egg-info/
.venv/
build/
dist/
.vizdiff/
*.pyc

# Generated copies of shared browser assets; prepare with package_vscode.py
vscode-extension/media/

# Local dependencies, credentials, editor state and test caches
node_modules/
.pytest_cache/
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
keystore.properties
signing.properties
.code*/
.agents/
.aws/
.vscode/
*.log
kicad-review/

# Retired third-party rendering assets; current releases use the owned engine
/extension/vendor/kicanvas.js
/extension/vendor/kicanvas-fonts.css
/extension/vendor/material-symbols.woff2
/*-skill-candidates/

# Required pinned PDF.js runtime assets, despite their upstream build/ directory
!/extension/vendor/pdfjs/build/
!/extension/vendor/pdfjs/build/pdf.min.mjs
!/extension/vendor/pdfjs/build/pdf.worker.min.mjs
